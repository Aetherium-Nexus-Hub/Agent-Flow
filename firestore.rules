rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profiles
    match /users/{userId} {
      allow read: if true; // Public needs to find the UID from the username
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Links
    match /links/{linkId} {
      allow read: if true; // Public needs to see the links
      allow write: if request.auth != null && request.auth.uid == request.resource.data.owner;
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }
  }
}
